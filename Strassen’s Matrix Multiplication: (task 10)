import java.io.*;
import java.util.*;

public class Solution {

    public static void matrixRotation(List<List<Integer>> matrix, int r) {
        int m = matrix.size();
        int n = matrix.get(0).size();
        
        // Convert List to a 2D array for easier manipulation
        int[][] mat = new int[m][n];
        for (int i = 0; i < m; i++) {
            for (int j = 0; j < n; j++) {
                mat[i][j] = matrix.get(i).get(j);
            }
        }
        
        // Number of concentric layers (rings)
        int layers = Math.min(m, n) / 2;
        
        for (int layer = 0; layer < layers; layer++) {
            List<Integer> list = new ArrayList<>();
            
            int r1 = layer, r2 = m - 1 - layer;
            int c1 = layer, c2 = n - 1 - layer;
            
            // 1. Extract Top row (left to right)
            for (int j = c1; j <= c2; j++) {
                list.add(mat[r1][j]);
            }
            // 2. Extract Right column (top + 1 to bottom)
            for (int i = r1 + 1; i <= r2; i++) {
                list.add(mat[i][c2]);
            }
            // 3. Extract Bottom row (right - 1 to left)
            for (int j = c2 - 1; j >= c1; j--) {
                list.add(mat[r2][j]);
            }
            // 4. Extract Left column (bottom - 1 to top + 1)
            for (int i = r2 - 1; i >= r1 + 1; i--) {
                list.add(mat[i][c1]);
            }
            
            // Reduce rotations using modulo of the layer's perimeter length
            int len = list.size();
            int effectiveR = r % len;
            
            // Rotate the list anti-clockwise (shift left by effectiveR)
            Collections.rotate(list, -effectiveR);
            
            int idx = 0;
            // Put the rotated elements back into the matrix
            for (int j = c1; j <= c2; j++) {
                mat[r1][j] = list.get(idx++);
            }
            for (int i = r1 + 1; i <= r2; i++) {
                mat[i][c2] = list.get(idx++);
            }
            for (int j = c2 - 1; j >= c1; j--) {
                mat[r2][j] = list.get(idx++);
            }
            for (int i = r2 - 1; i >= r1 + 1; i--) {
                mat[i][c1] = list.get(idx++);
            }
        }
        
        // Print the resulting matrix row by row
        for (int i = 0; i < m; i++) {
            StringBuilder sb = new StringBuilder();
            for (int j = 0; j < n; j++) {
                sb.append(mat[i][j]).append(j == n - 1 ? "" : " ");
            }
            System.out.println(sb.toString());
        }
    }

    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        
        if (!scanner.hasNextInt()) {
            scanner.close();
            return;
        }

        int m = scanner.nextInt();
        int n = scanner.nextInt();
        int r = scanner.nextInt();
        
        List<List<Integer>> matrix = new ArrayList<>();
        for (int i = 0; i < m; i++) {
            List<Integer> row = new ArrayList<>();
            for (int j = 0; j < n; j++) {
                row.add(scanner.nextInt());
            }
            matrix.add(row);
        }
        
        matrixRotation(matrix, r);
        scanner.close();
    }
}
