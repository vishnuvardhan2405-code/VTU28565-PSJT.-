import java.io.*;

public class Main {

    public static void main(String[] args) throws Exception {
        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));

        int n = Integer.parseInt(br.readLine());
        String s = br.readLine();

        String x = s + s;

        int m = x.length();

        int[] odd = new int[m];
        int l = 0, r = -1;

        for (int i = 0; i < m; i++) {
            int k = (i > r) ? 1 : Math.min(odd[l + r - i], r - i + 1);

            while (i - k >= 0 && i + k < m &&
                   x.charAt(i - k) == x.charAt(i + k)) {
                k++;
            }

            odd[i] = k;
            k--;

            if (i + k > r) {
                l = i - k;
                r = i + k;
            }
        }

        int[] even = new int[m];
        l = 0;
        r = -1;

        for (int i = 0; i < m; i++) {
            int k = (i > r) ? 0 : Math.min(even[l + r - i + 1], r - i + 1);

            while (i - k - 1 >= 0 && i + k < m &&
                   x.charAt(i - k - 1) == x.charAt(i + k)) {
                k++;
            }

            even[i] = k;
            k--;

            if (i + k > r) {
                l = i - k - 1;
                r = i + k;
            }
        }

        StringBuilder out = new StringBuilder();

        for (int start = 0; start < n; start++) {
            int end = start + n - 1;
            int best = 1;

            for (int center = start; center <= end; center++) {
                int len = Math.min(odd[center] * 2 - 1,
                                   Math.min(center - start + 1,
                                            end - center + 1) * 2 - 1);

                best = Math.max(best, len);
            }

            for (int center = start + 1; center <= end; center++) {
                int len = Math.min(even[center] * 2,
                                   Math.min(center - start,
                                            end - center + 1) * 2);

                best = Math.max(best, len);
            }

            out.append(best).append('\n');
        }

        System.out.print(out);
    }
}
